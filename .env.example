# ملف الربط بالخادم.
#
# لا تحرّره بيدك إن لم تكن مضطرًا — الأمر التالي يكتبه لك ويتحقق من القيم:
#
#     npm run connect
#
# انسخه إلى .env (بلا .example) إن أردت ملأه يدويًا. القيمتان الأوليان من
# لوحة Supabase ← Settings ← API.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# false = النسخة الحقيقية: دخول برمز SMS، وكل ما يُكتب أو يُرفع يُحفظ على الخادم.
# true  = بيانات تجريبية في ذاكرة الهاتف: أي رقم يدخل، ولا شيء يُحفظ، ولا يرى
#         أحد ما كتبه غيره. للعرض فقط، لا للتوزيع.
EXPO_PUBLIC_USE_MOCK_DATA=true

# ⚠️ المفتاح المطلوب أعلاه هو anon public وحده. مفتاح service_role لا يوضع في
#    التطبيق إطلاقًا: التطبيق يُوزَّع كملف، ومن يفتحه يقرأ ما فيه، فتصبح القاعدة
#    كلها مفتوحة له. الحماية الفعلية في سياسات RLS لا في إخفاء المفتاح العام.
