# انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية عند ربط Supabase الفعلي.
# طالما هذه القيم فارغة أو USE_MOCK_DATA=true، يعمل التطبيق ببيانات تجريبية محليًا
# ويسمح بـ "Development Login" بدل OTP الحقيقي.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# true = بيانات تجريبية + دخول تجريبي بدون OTP حقيقي
# false = استخدام Supabase الحقيقي (Phone OTP + Postgres)
EXPO_PUBLIC_USE_MOCK_DATA=true
